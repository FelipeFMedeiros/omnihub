# Desenvolvimento local. Copie apenas se .env ainda nao existir.
# Valores privados ficam somente no .env; nunca no Git ou no cofre.

# 1. Banco PostgreSQL do projeto (Docker) — usado hoje
NODE_ENV=development

# TASK-014: opt-in; sem importacao automatica de tokens globais.
CONNECTIONS_ENABLED=false
# JSON privado com activeVersion e chaves AES-256 em base64; fora do banco/Git.
CONNECTION_KEYS_FILE=
POSTGRES_USER=omnihub
POSTGRES_PASSWORD=omnihub_dev_pass
POSTGRES_DB=omnihub_db
# Porta no computador; o container continua na 5432.
POSTGRES_PORT=55432
DATABASE_URL=postgresql://omnihub:omnihub_dev_pass@127.0.0.1:55432/omnihub_db
DATABASE_POOL_SIZE=20
# Banco separado; criar antes dos testes. Nunca apontar para omnihub_db.
TEST_DATABASE_URL=postgresql://omnihub:omnihub_dev_pass@127.0.0.1:55432/omnihub_test_db

# 2. Hub API — usado hoje
HUB_HOST=0.0.0.0
HUB_PORT=3000
CORS_ORIGINS=http://localhost:5173

# 3. Mercado Livre — somente para OAuth/leitura externa, opcional nos testes locais
# Credenciais da aplicacao Omnihub, separadas do login MCP.
MELI_APP_ID=
MELI_CLIENT_SECRET=
# URL HTTPS exata cadastrada no app, encaminhada ao listener local.
MELI_REDIRECT_URI=
# ID do vendedor obtido no fluxo oficial de criacao de usuario de teste.
MELI_TEST_SELLER_ID=
MELI_OAUTH_LISTEN_PORT=3001
# Alinhar com PKCE no cadastro da aplicacao.
MELI_USE_PKCE=true
# Opcional: importar refresh oficial existente. O helper salva/rotaciona em output/meli.
MELI_REFRESH_TOKEN=

# 4. Servicos locais do pipeline — gerar valores privados com bun run setup:local
HUB_ADMIN_TOKEN=
MOCK_ERP_ADMIN_TOKEN=
ERP_WEBHOOK_SECRET=
HUB_ERP_WEBHOOK_URL=http://127.0.0.1:3000/api/webhooks/erp-stock

# Referencias publicas; dashboard e conta compradora serao usados nas proximas etapas.
# Conta compradora para futuras vendas simuladas, nao para o smoke de identidade.
MELI_TEST_BUYER_ID=
PUBLIC_HUB_URL=http://localhost:3000
PUBLIC_DASHBOARD_URL=http://localhost:5173

# TASK-004: Mock ERP
MOCK_ERP_PORT=3002
MOCK_ERP_URL=http://localhost:3002
MOCK_ERP_LATENCY_MS=250
MOCK_ERP_MAX_LATENCY_MS=600
MOCK_ERP_FAILURE_RATE=0.05

# TASK-013: dominio limitado ao workspace da sessao; legado fechado sem dono.
# Arquivo JSON privado, opcional, de destinos ERP previamente permitidos pelo operador.
# ERP_TARGETS_FILE=CAMINHO_PRIVADO_FORA_DO_GIT
# Cada negocio usa origem local e segredo HMAC exclusivos; ver docs/integrations/task-013.md.
# Runtime nao importa tokens MELI globais; OAuth por conexao fica na TASK-014.
# TASK-005: sessao de conta, CSRF e Turnstile preservados.
# setup:local gera JWT_SECRET privado; nunca usar em VITE_* ou enviar ao navegador.
JWT_SECRET=
AUTH_SESSION_TTL_SECONDS=3600
# PUBLIC_HUB_URL acima determina issuer e Secure. HTTPS obrigatorio fora do loopback.
# CORS_ORIGINS permite origens exatas com credenciais (sem *).
# Dummy oficial somente em development/test; sempre chama siteverify.
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_TIMEOUT_MS=5000
# Sitekey publica para TASK-006: VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Nunca confiar em headers de proxy por padrao. IPs exatos, somente apos proteger ingress.
# No tunel sem proxies confiaveis, todos os clientes compartilham o bucket do peer.
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_HEADER=cf-connecting-ip

# Shopee sera simulada localmente na TASK-012. Nao exige credenciais oficiais.
# Amazon sera configurada na TASK-011.

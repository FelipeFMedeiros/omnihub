# Desenvolvimento local. Copie apenas se .env ainda nao existir.
# Valores privados ficam somente no .env; nunca no Git ou no cofre.

# 1. Banco PostgreSQL do projeto (Docker) — usado hoje
NODE_ENV=development
POSTGRES_USER=omnihub
POSTGRES_PASSWORD=omnihub_dev_pass
POSTGRES_DB=omnihub_db
# Porta no computador; o container continua na 5432.
POSTGRES_PORT=55432
DATABASE_URL=postgresql://omnihub:omnihub_dev_pass@127.0.0.1:55432/omnihub_db
DATABASE_POOL_SIZE=20
# Banco separado; criar antes dos testes. Nunca apontar para omnihub_db.
TEST_DATABASE_URL=postgresql://omnihub:omnihub_dev_pass@127.0.0.1:55432/omnihub_test_db

# 2. Hub API — usado hoje
HUB_HOST=0.0.0.0
HUB_PORT=3000
CORS_ORIGINS=http://localhost:5173

# 3. Mercado Livre — somente para OAuth/leitura externa, opcional nos testes locais
# Credenciais da aplicacao Omnihub, separadas do login MCP.
MELI_APP_ID=
MELI_CLIENT_SECRET=
# URL HTTPS exata cadastrada no app, encaminhada ao listener local.
MELI_REDIRECT_URI=
# ID do vendedor obtido no fluxo oficial de criacao de usuario de teste.
MELI_TEST_SELLER_ID=
MELI_OAUTH_LISTEN_PORT=3001
# Alinhar com PKCE no cadastro da aplicacao.
MELI_USE_PKCE=true
# Opcional: importar refresh oficial existente. O helper salva/rotaciona em output/meli.
MELI_REFRESH_TOKEN=

# 4. Configuracoes futuras — ainda nao consumidas pelo codigo atual
# Conta compradora para futuras vendas simuladas, nao para o smoke de identidade.
MELI_TEST_BUYER_ID=
PUBLIC_HUB_URL=http://localhost:3000
PUBLIC_DASHBOARD_URL=http://localhost:5173

# TASK-004: Mock ERP
MOCK_ERP_PORT=3002
MOCK_ERP_URL=http://localhost:3002
MOCK_ERP_LATENCY_MS=250
MOCK_ERP_MAX_LATENCY_MS=600
MOCK_ERP_FAILURE_RATE=0.05

# TASK-005: JWT e Turnstile — preencher quando forem implementados.
# Nao confundir a chave publica do widget com a secret key do backend.
# JWT_SECRET=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Shopee sera simulada localmente na TASK-012. Nao exige credenciais oficiais.
# Amazon sera configurada na TASK-011.

{
  "name": "@omnihub/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./theme-init.js": "./src/theme-init.js",
    "./assets/*": "./src/assets/*"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry --exact-port",
    "build:storybook": "storybook build --disable-telemetry",
    "preview:storybook": "vite preview --host 127.0.0.1 --port 6006 --strictPort --outDir storybook-static",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.8.1"
  },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "10.6.5",
    "tailwindcss": "^4.3.4",
    "vite": "^7.0.0"
  }
}
